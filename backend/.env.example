# ===== 运行环境 =====
APP_NAME=contract-review
APP_ENV=dev
DEBUG=true
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ===== 数据库 =====
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=contract
MYSQL_PASSWORD=change-me
MYSQL_DB=contract_review

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ===== JWT =====
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== SiliconFlow (LLM / Embedding / Rerank) =====
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_REVIEW_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_INTENT_MODEL=deepseek-ai/DeepSeek-V4-Flash
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== Qdrant =====
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_REGULATIONS=kb_regulations
QDRANT_COLLECTION_INSTITUTION=kb_institution
QDRANT_COLLECTION_TEMPLATES=kb_templates

# ===== RAG 检索参数 =====
RAG_HYBRID_TOP_K=60
RAG_RERANK_TOP_K=5
RAG_QUERY_VARIANTS=3

# ===== Langfuse（自托管） =====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000

# ===== 文件存储 =====
UPLOAD_DIR=/data/uploads
OSS_BUCKET_DIR=/data/parsed

# ===== 前端 / CAS =====
FRONTEND_URL=http://localhost:5173
CAS_SERVER_URL=

# ===== LLM 并发与缓存 =====
LLM_PROMPT_CACHE=true
MAX_CONCURRENT_LLM=4
